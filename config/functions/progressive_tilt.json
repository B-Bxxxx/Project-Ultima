{
  "format": "cam-function",
  "version": 1,
  "name": "Progressive tilt",
  "description": "Layers tilt progressively around the X axis, pivoting on the lowest-Y edge of the part. Template for function files: every parameter listed here appears as a named input field in the GUI.",
  "type": "progressive_tilt",
  "parameters": {
    "start_tilt_deg": {
      "label": "Start tilt",
      "unit": "deg",
      "default": 0.0,
      "min": -45.0,
      "max": 45.0,
      "step": 1.0,
      "description": "Tilt of the first layer"
    },
    "end_tilt_deg": {
      "label": "End tilt",
      "unit": "deg",
      "default": 10.0,
      "min": -45.0,
      "max": 45.0,
      "step": 1.0,
      "description": "Tilt of the last layer"
    }
  }
}
