{
  "format": "cam-machine",
  "version": 1,
  "name": "Chain demo: 3-axis Cartesian",
  "description": "The plain XYZ printer as a chain (no rotary joint).",
  "kinematics": "generic_chain",
  "axes": [
    "X",
    "Y",
    "Z"
  ],
  "build_volume": {
    "x": [
      0,
      220
    ],
    "y": [
      0,
      220
    ],
    "z": [
      0,
      250
    ]
  },
  "parameters": {
    "max_3axis_tilt_deg": {
      "label": "Max. surface tilt",
      "unit": "deg",
      "default": 25.0,
      "min": 0.0,
      "max": 90.0,
      "description": "A warning is logged when a layer surface is tilted more than this."
    },
    "c_axis_x": {
      "label": "Part origin X (machine)",
      "unit": "mm",
      "default": 0.0
    },
    "c_axis_y": {
      "label": "Part origin Y (machine)",
      "unit": "mm",
      "default": 0.0
    },
    "c_axis_z": {
      "label": "Part origin Z (machine)",
      "unit": "mm",
      "default": 0.0
    }
  },
  "chain": {
    "tool": [
      {
        "axis": "X",
        "type": "linear",
        "direction": [
          1,
          0,
          0
        ]
      },
      {
        "axis": "Y",
        "type": "linear",
        "direction": [
          0,
          1,
          0
        ]
      },
      {
        "axis": "Z",
        "type": "linear",
        "direction": [
          0,
          0,
          1
        ]
      }
    ],
    "table": [],
    "part_origin": [
      "c_axis_x",
      "c_axis_y",
      "c_axis_z"
    ]
  }
}
