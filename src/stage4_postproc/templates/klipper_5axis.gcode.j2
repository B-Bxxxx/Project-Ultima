; Modular 5-Axis CAM Framework
; Profile: Klipper 5-Axis
;LAYER_COUNT:{{ layer_count }}
M83 ; Relative extrusion mode
G90 ; Absolute positioning

; Start G-Code
G90 ; Absolute XYZ
M83 ; Relative E
G28 ; Home all axes
G92 E0 ; Reset Extruder
; -------------------
{% for m in moves %}
{% if m.layer_marker is not none %}
;LAYER:{{ m.layer_marker }}
{% endif %}
{% if m.kind == "travel" %}
{% if m.retract %}
G1 E-{{ "%.3f"|format(profile.retract_distance) }} F{{ "%.0f"|format(profile.retract_speed) }} ; Retract
{% endif %}
{% if m.hop %}
{{ cmd }} Z{{ "%.3f"|format(m.lift_z) }} F{{ "%.0f"|format(profile.z_speed) }} ; Z-hop up
{% endif %}
{{ cmd }} X{{ "%.3f"|format(m.x) }} Y{{ "%.3f"|format(m.y) }}{% if not m.hop %} Z{{ "%.3f"|format(m.z) }}{% endif %}{% if profile.include_rotary_axes %} B{{ "%.3f"|format(m.b) }} C{{ "%.3f"|format(m.c) }}{% endif %} F{{ "%.0f"|format(m.feedrate) }} ; Travel
{% if m.hop %}
{{ cmd }} Z{{ "%.3f"|format(m.z) }} F{{ "%.0f"|format(profile.z_speed) }} ; Z-hop down
{% endif %}
{% if m.prime %}
G1 E{{ "%.3f"|format(profile.unretract_distance) }} F{{ "%.0f"|format(profile.unretract_speed) }} ; Prime
{% endif %}
{% else %}
{% if m.type_marker %}
; TYPE: {{ m.type_marker }}
{% endif %}
G1 X{{ "%.3f"|format(m.x) }} Y{{ "%.3f"|format(m.y) }} Z{{ "%.3f"|format(m.z) }}{% if profile.include_rotary_axes %} B{{ "%.3f"|format(m.b) }} C{{ "%.3f"|format(m.c) }}{% endif %} E{{ "%.5f"|format(m.e) }} F{{ "%.0f"|format(m.feedrate) }}
{% endif %}
{% endfor %}
; -------------------
; End G-Code
{{ cmd }} Z{{ "%.3f"|format(park_z) }} F{{ "%.0f"|format(profile.travel_speed) }}
{% if profile.include_rotary_axes %}
{{ cmd }} B0 C0 F{{ "%.0f"|format(profile.travel_speed) }}
{% endif %}
M104 S0 ; Turn off extruder
M140 S0 ; Turn off bed
M84 ; Disable motors
